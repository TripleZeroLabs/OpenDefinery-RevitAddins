<Window x:Class="OD_Common.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OD_Common"
        mc:Ignorable="d"
        Title="Sign in to OpenDefinery"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource OS2.Brush.Background}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TripleZeroLabs.Os2;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="30,26,30,22">
        <TextBlock Text="Sign in to OpenDefinery" Style="{StaticResource OS2.Text.Heading}" Margin="0,0,0,4"/>
        <TextBlock Text="Sign in to manage shared parameters and Collections."
                   Foreground="{DynamicResource OS2.Brush.TextSecondary}" Margin="0,0,0,18" TextWrapping="Wrap"/>

        <TextBlock Text="USERNAME" FontSize="11" Margin="0,0,0,4"/>
        <TextBox x:Name="UsernameTextBox" Height="38" FontSize="14" VerticalContentAlignment="Center"/>

        <TextBlock Text="PASSWORD" FontSize="11" Margin="0,14,0,4"/>
        <PasswordBox x:Name="PasswordBox" Height="38" FontSize="14" VerticalContentAlignment="Center"/>

        <CheckBox x:Name="RememberMeCheck" Content="Remember me on this computer" Margin="2,16,0,0"/>

        <Button x:Name="LoginButton" Content="Sign In" Height="40" Margin="0,20,0,0"
                IsDefault="True" Click="LoginButton_Click"/>
        <Button x:Name="CancelButton" Style="{StaticResource OS2.Button.Flat}" Content="Cancel"
                Margin="0,8,0,0" IsCancel="True" Click="CancelButton_Click"/>

        <TextBlock x:Name="LoginStatus" TextWrapping="Wrap" Margin="0,12,0,0"
                   Foreground="{DynamicResource OS2.Brush.Danger}"/>
    </StackPanel>
</Window>
