<Window x:Class="OD_FamEditor.Window_FamEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OD_FamEditor"
        mc:Ignorable="d"
        Title="OpenDefinery Family Editor"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource OS2.Brush.Background}"
        Width="1200" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TripleZeroLabs.Os2;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- No cell-selection highlight or focus rectangle: just a row hover colour, and the
                 dark-grey border only on the value editor being typed into. -->
            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource OS2.Brush.TextPrimary}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DataGridRow">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource OS2.Brush.SurfaceAlt}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid x:Name="MainContent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Left: family types ============ -->
            <Border Grid.Column="0" Background="{DynamicResource OS2.Brush.Surface}"
                    BorderBrush="{DynamicResource OS2.Brush.Border}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="FAMILY TYPES" Margin="16,16,16,8"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource OS2.Brush.TextSecondary}"/>
                    <ListBox Grid.Row="1" x:Name="TypesList"
                             Style="{StaticResource OS2.Nav.ListBox}"
                             ItemContainerStyle="{StaticResource OS2.Nav.ListBoxItem}"
                             DisplayMemberPath="Name"
                             Margin="8,0,8,12"
                             SelectionChanged="TypesList_SelectionChanged"/>
                </Grid>
            </Border>

            <!-- ============ Right: parameters ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar: count + Collection to validate/swap against -->
                <Border Grid.Row="0" Background="{DynamicResource OS2.Brush.Surface}"
                        BorderBrush="{DynamicResource OS2.Brush.Border}" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HeaderText" Grid.Column="0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OS2.Brush.TextSecondary}" Text="Reading family…"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Collection:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource OS2.Brush.TextSecondary}"/>
                            <ComboBox x:Name="CollectionCombo" Width="220" DisplayMemberPath="Name"
                                      SelectionChanged="CollectionCombo_Changed"
                                      ToolTip="Shared parameters already in this Collection show a green check; others get a + to add, and Swap targets come from here."/>
                            <Button x:Name="SignInButton" Style="{StaticResource OS2.Button.Secondary}"
                                    Content="Sign In" Margin="8,0,0,0" Click="SignInButton_Click"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Search + filters -->
                <Grid Grid.Row="1" Margin="16,12,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0" Height="32"
                             TextChanged="Search_Changed"
                             ToolTip="Search by parameter name"/>
                    <ComboBox x:Name="GroupFilter" Grid.Column="2" Width="200" Height="32"
                              SelectionChanged="Filter_Changed"
                              ToolTip="Filter by parameter group"/>
                    <ComboBox x:Name="BindingFilter" Grid.Column="4" Width="150" Height="32"
                              SelectionChanged="Filter_Changed"
                              ToolTip="Filter by binding: type, instance, shared, family, or built-in"/>
                    <ComboBox x:Name="DataTypeFilter" Grid.Column="6" Width="180" Height="32"
                              SelectionChanged="Filter_Changed"
                              ToolTip="Filter by data type"/>
                    <CheckBox x:Name="ShowGroupsCheck" Grid.Column="8" Content="Show Groups"
                              VerticalAlignment="Center" IsChecked="True" Checked="ShowGroups_Changed" Unchecked="ShowGroups_Changed"
                              ToolTip="Group the parameters by parameter group (collapsible), or show a flat list."/>
                </Grid>

                <!-- Parameter grid, grouped by parameter group (collapsible) -->
                <DataGrid x:Name="ParamGrid" Grid.Row="2" Margin="16,0,16,12"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionUnit="FullRow" HeadersVisibility="Column"
                          CanUserSortColumns="False">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True" Margin="0,4,0,0"
                                                          Background="{DynamicResource OS2.Brush.SurfaceAlt}">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource OS2.Brush.TextPrimary}"/>
                                                            <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                                       Foreground="{DynamicResource OS2.Brush.TextSecondary}"/>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <!-- Collection status: green check (in collection) / blue family / grey R / + to add -->
                        <DataGridTemplateColumn Header="Coll." IsReadOnly="True" Width="46">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center">
                                        <TextBlock Text="&#x2714;" FontSize="14" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource OS2.Brush.Success}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsShared}" Value="True"/>
                                                                <Condition Binding="{Binding InSelectedCollection}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Content="+" FontSize="16" FontWeight="Bold" Padding="8,0"
                                                Click="AddToCollection_Click"
                                                ToolTip="Add this parameter to the selected Collection">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OS2.Button.Flat}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsShared}" Value="True"/>
                                                                <Condition Binding="{Binding InSelectedCollection}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Parameter: big name + subdued GUID (shared only) with a copy button -->
                        <DataGridTemplateColumn Header="Parameter" Width="2*" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding GuidVisibility}">
                                            <TextBlock Text="{Binding Guid}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource OS2.Brush.TextSecondary}"/>
                                            <Button Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                    Style="{StaticResource OS2.Button.Flat}" Padding="4,0" Margin="6,0,0,0"
                                                    Tag="{Binding Guid}" Click="Copy_Click" ToolTip="Copy GUID"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Value: checkbox (Yes/No) / editable text / read-only (formula result) + copy on hover -->
                        <DataGridTemplateColumn Header="Value" Width="3*" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsThreeState="True" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  IsChecked="{Binding BoolValue, Mode=TwoWay}" Click="YesNo_Click">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsYesNo}" Value="True"/>
                                                                <Condition Binding="{Binding HasFormula}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>

                                        <TextBox Grid.Column="0" Text="{Binding Value, Mode=OneWay}"
                                                 LostKeyboardFocus="Value_Committed" VerticalContentAlignment="Center">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <!-- Borderless until focused, so cells have no outline at rest. -->
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Padding" Value="2,0"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsYesNo}" Value="False"/>
                                                                <Condition Binding="{Binding HasFormula}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        <!-- The one cell being edited gets a thick dark-grey border. -->
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                            <Setter Property="BorderBrush" Value="#4B5563"/>
                                                            <Setter Property="Background" Value="{DynamicResource OS2.Brush.Background}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <TextBlock Grid.Column="0" Text="{Binding CalculatedValue}" VerticalAlignment="Center" Margin="2,0"
                                                   Foreground="{DynamicResource OS2.Brush.TextSecondary}" FontStyle="Italic"
                                                   Cursor="Hand" MouseLeftButtonUp="FormulaResult_Click"
                                                   ToolTip="This value is driven by a formula — click to edit it.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasFormula}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Button Grid.Column="1" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                Padding="4,0"
                                                Tag="{Binding Value}" Click="Copy_Click" ToolTip="Copy value">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OS2.Button.Flat}">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True"
                                                                     Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Data Type" Binding="{Binding DataType}" Width="Auto" IsReadOnly="True"/>

                        <!-- Binding: dropdown (Type / Instance). Toggling removes & re-adds the param. -->
                        <DataGridTemplateColumn Header="Binding" Width="Auto" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Width="96" Margin="2" VerticalAlignment="Center"
                                              SelectedValuePath="Content" SelectedValue="{Binding Binding, Mode=OneWay}"
                                              IsEnabled="{Binding CanEditKind}" SelectionChanged="Binding_Changed">
                                        <ComboBoxItem Content="Type"/>
                                        <ComboBoxItem Content="Instance"/>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Kind: dropdown (Family / Shared); disabled for built-in -->
                        <DataGridTemplateColumn Header="Kind" Width="Auto" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Width="96" Margin="2" VerticalAlignment="Center"
                                              SelectedValuePath="Content" SelectedValue="{Binding Kind, Mode=OneWay}"
                                              IsEnabled="{Binding CanEditKind}" SelectionChanged="Kind_Changed">
                                        <ComboBoxItem Content="Family"/>
                                        <ComboBoxItem Content="Shared"/>
                                        <ComboBoxItem Content="Built-in"/>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions (no header): Formula (coloured when active) + Swap (shared only) -->
                        <DataGridTemplateColumn Header="" Width="Auto" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="&#402;(x)" Click="Formula_Click" Padding="10,0" Margin="2"
                                                ToolTip="Edit the formula">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OS2.Button.Secondary}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanEditFormula}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasFormula}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource OS2.Brush.Success}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource OS2.Brush.TextOnPrimary}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource OS2.Brush.Success}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Swap" Click="Swap_Click" Padding="10,0" Margin="2"
                                                ToolTip="Swap this parameter for another of the same data type">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OS2.Button.Secondary}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsShared}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- Login overlay (Collection features need a session; reused from Param Manager if present) -->
        <Grid x:Name="LoginOverlay" Background="{DynamicResource OS2.Brush.Overlay}" Visibility="Collapsed">
            <Border Background="{DynamicResource OS2.Brush.Card}" Width="400" Padding="30"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Sign in to OpenDefinery" Style="{StaticResource OS2.Text.Heading}" Margin="0,0,0,4"/>
                    <TextBlock Text="Required for Collection features (green checks, add, and swap)."
                               Foreground="{DynamicResource OS2.Brush.TextSecondary}" Margin="0,0,0,16" TextWrapping="Wrap"/>
                    <TextBlock Text="USERNAME" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="UsernameTextBox" Height="38" FontSize="14" VerticalContentAlignment="Center"/>
                    <TextBlock Text="PASSWORD" FontSize="11" Margin="0,14,0,4"/>
                    <PasswordBox x:Name="PasswordBox" Height="38" FontSize="14" VerticalContentAlignment="Center"/>
                    <Button x:Name="LoginButton" Content="Login" Height="40" Margin="0,20,0,0" IsDefault="True" Click="LoginButton_Click"/>
                    <Button Style="{StaticResource OS2.Button.Flat}" Content="Cancel" Margin="0,8,0,0" Click="LoginCancel_Click"/>
                    <TextBlock x:Name="LoginStatus" TextWrapping="Wrap" Margin="0,12,0,0"
                               Foreground="{DynamicResource OS2.Brush.Danger}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Not-a-family state -->
        <Grid x:Name="NotFamilyPanel" Visibility="Collapsed" Background="{DynamicResource OS2.Brush.Background}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                <TextBlock Text="Open a family to edit" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource OS2.Brush.TextSecondary}"/>
                <TextBlock Text="The Family Editor works on the currently open Revit family. Open or edit a family, then reopen this window."
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"
                           Foreground="{DynamicResource OS2.Brush.TextSecondary}"/>
            </StackPanel>
        </Grid>

        <!-- Toast: confirms an add-to-collection with an Undo action -->
        <Border x:Name="Toast" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,28" Background="{DynamicResource OS2.Brush.Toolbar}" CornerRadius="6" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastText" VerticalAlignment="Center"
                           Foreground="{DynamicResource OS2.Brush.ToolbarForeground}"/>
                <Button x:Name="ToastUndo" Content="Undo" Margin="18,0,0,0" Padding="8,0"
                        Style="{StaticResource OS2.Button.Flat}" Foreground="#8FC0FF"
                        Click="ToastUndo_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
