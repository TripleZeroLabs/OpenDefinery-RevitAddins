<Window x:Class="OD_FamEditor.Window_FormulaEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OD_FamEditor"
        mc:Ignorable="d"
        Title="Formula"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource OS2.Brush.Background}"
        Width="620" SizeToContent="Height"
        ResizeMode="CanResize" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TripleZeroLabs.Os2;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeadingText" Style="{StaticResource OS2.Text.Heading}" Text="Formula"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,10" TextWrapping="Wrap"
                   Foreground="{DynamicResource OS2.Brush.TextSecondary}"
                   Text="Enter a Revit formula. It's stored on a single line — line breaks are collapsed when you save. Leave empty to clear the formula."/>

        <TextBox Grid.Row="2" x:Name="FormulaBox" MinHeight="140"
                 FontFamily="Consolas" FontSize="14"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="ClearButton" Style="{StaticResource OS2.Button.Flat}"
                    Content="Clear formula" Padding="14,0" Click="ClearButton_Click"/>
            <Button x:Name="CancelButton" Style="{StaticResource OS2.Button.Flat}"
                    Content="Cancel" Margin="10,0,0,0" Padding="18,0" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="Save" Margin="10,0,0,0" Padding="24,0" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
