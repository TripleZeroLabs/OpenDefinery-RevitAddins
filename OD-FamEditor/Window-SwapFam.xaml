<Window x:Class="OD_FamEditor.Window_SwapFam"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OD_FamEditor"
        mc:Ignorable="d"
        Title="Swap Parameter"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource OS2.Brush.Background}"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TripleZeroLabs.Os2;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource OS2.Text.Heading}" Text="Swap parameter"/>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="14,10"
                Background="{DynamicResource OS2.Brush.Surface}"
                BorderBrush="{DynamicResource OS2.Brush.Border}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="SourceName" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="SourceMeta" FontFamily="Consolas" FontSize="11"
                           Foreground="{DynamicResource OS2.Brush.TextSecondary}"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="Swap to (same data type, not already in this family):"
                   Margin="0,18,0,6" Foreground="{DynamicResource OS2.Brush.TextSecondary}"/>
        <ComboBox Grid.Row="3" x:Name="TargetCombo" Height="34" DisplayMemberPath="Name"/>

        <TextBlock Grid.Row="4" Margin="0,14,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource OS2.Brush.TextSecondary}"
                   Text="Values (or the formula) transfer to the new parameter, and formulas that referenced the old one are updated. This is undoable in Revit — review dependent formulas afterward."/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource OS2.Button.Flat}"
                    Content="Cancel" Padding="18,0" Click="CancelButton_Click"/>
            <Button x:Name="SwapButton" Content="Swap" Margin="10,0,0,0" Padding="24,0" Click="SwapButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
