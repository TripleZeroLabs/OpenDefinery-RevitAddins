<Window x:Class="OD_FamEditor.Window_Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OD_FamEditor"
        mc:Ignorable="d"
        Title="OpenDefinery"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource OS2.Brush.Background}"
        Width="440" SizeToContent="Height"
        MinHeight="150"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TripleZeroLabs.Os2;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeadingText" Style="{StaticResource OS2.Text.Heading}" Text="OpenDefinery"/>

        <TextBlock Grid.Row="1" x:Name="MessageText" TextWrapping="Wrap" Margin="0,12,0,0"
                   Foreground="{DynamicResource OS2.Brush.TextSecondary}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource OS2.Button.Flat}"
                    Content="Cancel" Padding="18,0" Click="Cancel_Click"/>
            <Button x:Name="OkButton" Content="OK" Margin="10,0,0,0" Padding="22,0"
                    IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
