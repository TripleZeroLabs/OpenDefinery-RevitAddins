<Window x:Class="OD_ParamManager.Window_ExportParams"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OD_ParamManager"
        mc:Ignorable="d"
        Title="Export Shared Parameters"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{DynamicResource OD.Brush.Background}"
        Width="900" Height="650"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OpenDefinery.Theme;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- ============ Main UI ============ -->
        <Grid x:Name="MainUiGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Shared "Current Family" panel: param list + export + new collection -->
            <local:Control_CurrentFamily x:Name="CurrentFamily" Grid.Row="0"/>

            <!-- Footer: explicit Close. Escape deliberately does NOT close this window. -->
            <Border Grid.Row="1" Background="{DynamicResource OD.Brush.Surface}" Padding="16,12">
                <Button x:Name="CloseButton"
                        Style="{StaticResource OD.Button.Secondary}"
                        Content="Close"
                        HorizontalAlignment="Right"
                        Padding="24,0"
                        Click="CloseButton_Click"/>
            </Border>
        </Grid>

        <!-- ============ Login overlay ============ -->
        <Grid x:Name="OverlayGrid" Background="{DynamicResource OD.Brush.Overlay}" Visibility="Collapsed">
            <Border x:Name="LoginCard"
                    Background="{DynamicResource OD.Brush.Card}"
                    Width="400" Padding="30"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Sign in to OpenDefinery" Style="{StaticResource OD.Text.Heading}" Margin="0,0,0,4"/>
                    <TextBlock Text="Required to export parameters."
                               Foreground="{DynamicResource OD.Brush.TextSecondary}" Margin="0,0,0,16"/>
                    <TextBlock Text="USERNAME" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="UsernameTextBox" Height="38" FontSize="14" VerticalContentAlignment="Center"/>
                    <TextBlock Text="PASSWORD" FontSize="11" Margin="0,14,0,4"/>
                    <PasswordBox x:Name="PasswordBox" Height="38" FontSize="14" VerticalContentAlignment="Center"/>
                    <Button x:Name="LoginButton" Content="Login" Height="40" Margin="0,20,0,0"
                            IsDefault="True" Click="LoginButton_Click"/>
                    <TextBlock x:Name="LoginStatusText" TextWrapping="Wrap" Margin="0,12,0,0"
                               Foreground="{DynamicResource OD.Brush.Danger}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
