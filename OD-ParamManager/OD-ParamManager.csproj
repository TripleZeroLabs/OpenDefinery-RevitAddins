<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>OD_ParamManager</RootNamespace>
    <AssemblyName>OpenDefinery-ParamManager</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- This add-in uses the Revit API -->
    <UseRevitApi>true</UseRevitApi>
    <!-- Opt in to the post-build Revit Addins deployment (see Directory.Build.targets) -->
    <IsRevitAddin>true</IsRevitAddin>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenDefinery\OpenDefinery.csproj" />
    <!-- The theme (TripleZeroLabs.Os2) lives in its own repo/solution, sibling to this one. -->
    <ProjectReference Include="..\..\TripleZeroLabs.Os2\TripleZeroLabs.Os2\TripleZeroLabs.Os2.csproj" />
  </ItemGroup>

  <!-- Newtonsoft/RestSharp removed (Revit/Dynamo DLL-conflict sources). HTTP + JSON now
       flow through the core's OdHttp/OdJson (HttpClient + System.Text.Json), which is
       pulled in transitively via the OpenDefinery project reference. -->
  <ItemGroup />

  <!-- DPAPI (ProtectedData) for the encrypted "Remember me" session store. On net48 it lives
       in the System.Security framework assembly; on net8/net10-windows it ships inbox in the
       Microsoft.WindowsDesktop.App shared framework (WPF), so no package is needed there. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ribbon/UI icons referenced via pack:// URIs -->
    <Resource Include="Assets\Icons\*.png" />
    <!-- Revit add-in manifest (deployment handled in Phase 5) -->
    <None Include="OpenDefinery-ParamManager.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
