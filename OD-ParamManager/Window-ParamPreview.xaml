<Window x:Class="OD_ParamManager.Window_ParamPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OD_ParamManager"
        mc:Ignorable="d"
        Title="Export Preview"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{DynamicResource OS2.Brush.Background}"
        Width="900" Height="600"
        MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TripleZeroLabs.Os2;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- One tab-delimited field: borderless, monospace, selectable. Double-click selects
                 the whole field (tab is the delimiter). -->
            <Style x:Key="OS2.PreviewField" TargetType="{x:Type TextBox}">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource OS2.Brush.TextPrimary}"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="0,3,32,3"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="IsInactiveSelectionHighlightEnabled" Value="True"/>
                <Setter Property="CaretBrush" Value="{DynamicResource OS2.Brush.Primary}"/>
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PreviewField_PreviewMouseLeftButtonDown"/>
                <EventSetter Event="GotKeyboardFocus" Handler="PreviewField_GotFocus"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource OS2.Brush.Surface}"
                BorderBrush="{DynamicResource OS2.Brush.Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource OS2.Brush.TextSecondary}"
                       Text="The exact PARAM line(s) that will be written. Click a line number to select a row (Ctrl/Shift for several), or double-click a field to select one value, then Copy to Clipboard. Or save everything as a text file."/>
        </Border>

        <Border Grid.Row="1" Margin="16,12"
                BorderBrush="{DynamicResource OS2.Brush.Border}" BorderThickness="1"
                Background="{DynamicResource OS2.Brush.Surface}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PreviewList" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRowSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource OS2.Brush.SurfaceAlt}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Gutter"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c0"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c1"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c2"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c3"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c4"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c5"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c6"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c7"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c8"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" MinWidth="40" Cursor="Hand"
                                        Background="{DynamicResource OS2.Brush.SurfaceAlt}"
                                        BorderBrush="{DynamicResource OS2.Brush.Border}" BorderThickness="0,0,1,0"
                                        MouseLeftButtonDown="PreviewGutter_MouseLeftButtonDown"
                                        ToolTip="Click to select this row (Ctrl/Shift for several)">
                                    <TextBlock Text="{Binding Number}" Margin="8,3,10,3"
                                               FontFamily="Consolas" FontSize="12" TextAlignment="Right"
                                               Foreground="{DynamicResource OS2.Brush.TextSecondary}"/>
                                </Border>

                                <TextBox Grid.Column="1" Style="{StaticResource OS2.PreviewField}" Margin="10,0,0,0" Text="{Binding Fields[0], Mode=OneWay}"/>
                                <TextBox Grid.Column="2" Style="{StaticResource OS2.PreviewField}" Text="{Binding Fields[1], Mode=OneWay}"/>
                                <TextBox Grid.Column="3" Style="{StaticResource OS2.PreviewField}" Text="{Binding Fields[2], Mode=OneWay}"/>
                                <TextBox Grid.Column="4" Style="{StaticResource OS2.PreviewField}" Text="{Binding Fields[3], Mode=OneWay}"/>
                                <TextBox Grid.Column="5" Style="{StaticResource OS2.PreviewField}" Text="{Binding Fields[4], Mode=OneWay}"/>
                                <TextBox Grid.Column="6" Style="{StaticResource OS2.PreviewField}" Text="{Binding Fields[5], Mode=OneWay}"/>
                                <TextBox Grid.Column="7" Style="{StaticResource OS2.PreviewField}" Text="{Binding Fields[6], Mode=OneWay}"/>
                                <TextBox Grid.Column="8" Style="{StaticResource OS2.PreviewField}" Text="{Binding Fields[7], Mode=OneWay}"/>
                                <TextBox Grid.Column="9" Style="{StaticResource OS2.PreviewField}" Text="{Binding Fields[8], Mode=OneWay}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource OS2.Brush.Surface}"
                BorderBrush="{DynamicResource OS2.Brush.Border}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Button x:Name="CopyButton" HorizontalAlignment="Left" Style="{StaticResource OS2.Button.Secondary}"
                        Padding="18,0" Click="CopyButton_Click"
                        ToolTip="Copy the selected rows (tab-separated), or the selected value, to the clipboard">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Copy to Clipboard" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CloseButton" Style="{StaticResource OS2.Button.Flat}"
                            Content="Close" Padding="18,0" Click="CloseButton_Click"/>
                    <Button x:Name="DownloadButton" Margin="10,0,0,0" Padding="18,0" Click="DownloadButton_Click"
                            ToolTip="Save all previewed parameters as a Revit shared parameter text file">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Download TXT File" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
