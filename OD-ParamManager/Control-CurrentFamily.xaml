<UserControl x:Class="OD_ParamManager.Control_CurrentFamily"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OD_ParamManager"
             mc:Ignorable="d"
             FontFamily="Segoe UI" FontSize="13"
             d:DesignWidth="1000" d:DesignHeight="600">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TripleZeroLabs.Os2;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource OS2.Brush.Background}">

        <!-- ============ Main content ============ -->
        <Grid x:Name="MainContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tool row (below the tabs): collection validation on the left, actions on the right -->
            <Border Grid.Row="0" Background="{DynamicResource OS2.Brush.Surface}"
                    BorderBrush="{DynamicResource OS2.Brush.Border}" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Collection to validate against (green-check) + create new -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Check against Collection:" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OS2.Brush.TextSecondary}" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CollectionCombo" Width="240" DisplayMemberPath="Name" VerticalAlignment="Center"
                                  SelectionChanged="CollectionCombo_Changed"
                                  ToolTip="Parameters already in this Collection are marked with a green check."/>
                        <Button x:Name="NewCollectionButton" Style="{StaticResource OS2.Button.Secondary}"
                                Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Width="34" Margin="8,0,0,0"
                                Click="NewCollectionButton_Click"
                                ToolTip="Create a new Collection on OpenDefinery."/>
                    </StackPanel>

                    <!-- Right: Upload/Delete act on the selection (appear when rows are selected);
                         Download previews & saves the whole list, so it's always available. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <StackPanel x:Name="SelectionActions" Orientation="Horizontal" Visibility="Collapsed">
                            <Button x:Name="UploadButton" Content="Upload" Padding="22,0" Click="UploadButton_Click"
                                    ToolTip="Upload the selected parameters to an OpenDefinery Collection"/>
                            <Button x:Name="DeleteButton" Style="{StaticResource OS2.Button.Danger}" Margin="8,0,0,0" Click="DeleteButton_Click"
                                    ToolTip="Delete the selected parameters from the current model">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Delete" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button x:Name="DownloadButton" Style="{StaticResource OS2.Button.Secondary}" Margin="8,0,0,0" Click="DownloadButton_Click"
                                ToolTip="Preview and save all listed parameters as a shared parameter text file">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Download" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Filter row -->
            <Grid Grid.Row="1" Margin="16,12,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilterTextBox" Grid.Column="0" Height="32"
                         TextChanged="Filter_Changed"
                         ToolTip="Filter by parameter name or GUID"/>
                <ComboBox x:Name="InCollectionFilterCombo" Grid.Column="2" Width="170" Height="32"
                          SelectionChanged="InCollectionFilter_Changed"
                          ToolTip="Filter by whether the parameter is already in the Collection selected above"/>
                <ComboBox x:Name="DataTypeFilterCombo" Grid.Column="4" Width="180" Height="32"
                          SelectionChanged="DataTypeFilter_Changed"
                          ToolTip="Filter by data type"/>
                <TextBlock x:Name="CountText" Grid.Column="5" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{DynamicResource OS2.Brush.TextSecondary}"/>
            </Grid>

            <!-- Parameter list fills the tab -->
            <DataGrid x:Name="DataGrid_Params"
                      Grid.Row="2" Margin="16,0,16,12"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionUnit="FullRow"
                      SelectionMode="Extended"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      SelectionChanged="DataGrid_Params_SelectionChanged"
                      Sorting="DataGrid_Params_Sorting">
                <DataGrid.Columns>
                    <!-- Already-in-selected-collection indicator -->
                    <DataGridTemplateColumn Header="In Coll." SortMemberPath="InSelectedCollection" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="&#x2714;" FontSize="15" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource OS2.Brush.Success}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InSelectedCollection}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Parameter" Width="*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Guid}" FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource OS2.Brush.TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True"
                                                                 Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}">
                                                        <Setter Property="Foreground" Value="{DynamicResource OS2.Brush.TextOnPrimarySubtle}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Data Type" Binding="{Binding DataType}" Width="Auto" SortMemberPath="DataType"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ============ Not-connected state ============ -->
        <Grid x:Name="NotConnectedPanel" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                <TextBlock x:Name="NotConnectedHeading" Text="No Revit model open"
                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource OS2.Brush.TextSecondary}"/>
                <TextBlock x:Name="NotConnectedBody"
                           Text="Open a Revit family or project to see its shared parameters here."
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"
                           Foreground="{DynamicResource OS2.Brush.TextSecondary}"/>
            </StackPanel>
        </Grid>

        <!-- ============ New Collection overlay ============ -->
        <Grid x:Name="OverlayGrid" Background="{DynamicResource OS2.Brush.Overlay}" Visibility="Collapsed">
            <Border x:Name="NewCollectionCard"
                    Background="{DynamicResource OS2.Brush.Card}"
                    Width="480" Padding="30"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="New Collection" Style="{StaticResource OS2.Text.Heading}" Margin="0,0,0,16"/>
                    <TextBlock Text="NAME" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="NewCollectionName" Height="34"/>
                    <TextBlock Text="DESCRIPTION" FontSize="11" Margin="0,14,0,4"/>
                    <TextBox x:Name="NewCollectionDescription" Height="80"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                    <CheckBox x:Name="NewCollectionPublic" Content="Make this Collection public" Margin="0,14,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="CancelNewCollectionButton"
                                Style="{StaticResource OS2.Button.Flat}"
                                Content="Cancel"
                                Click="CancelNewCollectionButton_Click"/>
                        <Button x:Name="CreateCollectionButton"
                                Content="Create" Margin="10,0,0,0" Padding="20,0"
                                Click="CreateCollectionButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="NewCollectionStatus" TextWrapping="Wrap" Margin="0,12,0,0"
                               Foreground="{DynamicResource OS2.Brush.Danger}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
